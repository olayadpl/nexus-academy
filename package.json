{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall:codespace": "bash scripts/postinstall.sh",
    "validate:payload-paths": "node ./scripts/validate-payload-paths.mjs",
    "ci:arch": "pnpm validate:payload-paths",
    "gen:feature": "sh -c 'test -n \"$1\" && test -n \"$2\" && hygen feature new --name \"$1\" --entity \"$2\" || (echo \"Uso: pnpm gen:feature <feature> <entity>\" && exit 1)' --",
    "gen:feature:crud": "sh -c 'test -n \"$1\" && test -n \"$2\" && hygen feature crud --name \"$1\" --entity \"$2\" || (echo \"Uso: pnpm gen:feature:crud <feature> <entity>\" && exit 1)' --",
    "gen:feature:full": "sh -c 'test -n \"$1\" && test -n \"$2\" && hygen feature new --name \"$1\" --entity \"$2\" && hygen feature crud --name \"$1\" --entity \"$2\" || (echo \"Uso: pnpm gen:feature:full <feature> <entity>\" && exit 1)' --",
    "gen:feature:multi": "node ./scripts/gen-feature-multi.mjs",
    "payload:collect": "node ./scripts/generate-payload-collections.mjs",
    "payload:seed": "node ./scripts/create-admin.mjs",
    "payload:seed:courses": "node ./scripts/seed-courses.mjs"
  },
